    <Product>ROOT Storage Explorer</Product>
    <Description>Sistem Penjelajah dan Analisis Penyimpanan Cepat untuk Windows</Description>
    <Company>ROOT</Company>
    <Copyright>Copyright © 2026 ROOT</Copyright>
    <Version>8.0.0</Version>
    <AssemblyVersion>8.0.0.0</AssemblyVersion>
    <FileVersion>8.0.0.0</FileVersion>
    <ApplicationIcon>Assets\Root.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\Root.ico" />
    <Resource Include="Assets\Root.png" />
    <Resource Include="Assets\RootLight.png" />
