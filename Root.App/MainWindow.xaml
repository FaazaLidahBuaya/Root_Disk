<Window x:Class="Root.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Root.App.ViewModels"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Icon="{DynamicResource AppLogo}"
        Title="ROOT — Pohon Penyimpanan"
        Height="660" Width="980" MinHeight="480" MinWidth="740"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BrushDarkBg}"
        FontFamily="{StaticResource FontMain}"
        Foreground="{DynamicResource BrushTextPrimary}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="8" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="62" />
            <RowDefinition Height="34" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Bilah judul jendela Windows. -->
        <Border Grid.Row="0" Background="{DynamicResource BrushSidebarBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Image Width="23" Height="23" Source="{DynamicResource AppLogo}" Stretch="Uniform" Margin="0,0,8,0" />
                    <TextBlock Text="ROOT" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <Button Grid.Column="1" Width="38" Margin="0,0,6,0" Command="{Binding ToggleThemeCommand}"
                        Style="{StaticResource WindowCaptionButtonStyle}" ToolTip="Ganti tema terang atau gelap"
                        AutomationProperties.Name="Ganti tema terang atau gelap" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="13">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="&#xE708;" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDarkTheme}" Value="True">
                                        <Setter Property="Text" Value="&#xE706;" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Stretch" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Width="46" Style="{StaticResource WindowCaptionButtonStyle}" Click="MinimizeWindow_Click"
                            ToolTip="Minimalkan" AutomationProperties.Name="Minimalkan jendela">
                        <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                    </Button>
                    <Button x:Name="MaximizeButton" Width="46" Style="{StaticResource WindowCaptionButtonStyle}" Click="MaximizeWindow_Click"
                            ToolTip="Maksimalkan" AutomationProperties.Name="Maksimalkan jendela">
                        <TextBlock x:Name="MaximizeGlyph" Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                    </Button>
                    <Button Width="46" Style="{StaticResource WindowCloseButtonStyle}" Click="CloseWindow_Click"
                            ToolTip="Tutup" AutomationProperties.Name="Tutup ROOT">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Satu toolbar untuk memilih target dan mengendalikan pemindaian. -->
        <Border Grid.Row="1" Background="{DynamicResource BrushSidebarBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="0,0,0,1" Padding="16,8">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="1" Width="112" Height="36" Margin="0,0,8,0" ToolTip="Pilih tampilan pohon atau peta kotak">
                    <Border Background="{DynamicResource BrushInputBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="7" />
                    <Border x:Name="ViewModeIndicator" Width="52" Height="28" HorizontalAlignment="Left" Margin="3"
                            Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}"
                            BorderThickness="1" CornerRadius="5" IsHitTestVisible="False">
                        <Border.RenderTransform><TranslateTransform X="0" /></Border.RenderTransform>
                    </Border>
                    <Grid Panel.ZIndex="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Button x:Name="ListModeButton" Grid.Column="0" Command="{Binding NavigateToHierarchyCommand}"
                                Style="{StaticResource ViewModeButtonStyle}"
                                AutomationProperties.Name="Tampilan pohon penyimpanan">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,4,0"/><TextBlock Text="Pohon" FontSize="10"/></StackPanel>
                        </Button>
                        <Button x:Name="VisualModeButton" Grid.Column="1" Command="{Binding NavigateToTreemapCommand}"
                                Style="{StaticResource ViewModeButtonStyle}"
                                AutomationProperties.Name="Tampilan peta kotak treemap">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80A;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,4,0"/><TextBlock Text="Kotak" FontSize="10"/></StackPanel>
                        </Button>
                    </Grid>
                </Grid>
                <ComboBox Grid.Column="2" Width="180" Height="36" Margin="0,0,8,0"
                          ItemsSource="{Binding Scanner.Drives}" SelectedItem="{Binding Scanner.SelectedDrive, Mode=TwoWay}"
                          IsEnabled="{Binding Scanner.CanStartScan}"
                          Style="{StaticResource RootComboBoxStyle}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Column="3" Content="Folder…" Command="{Binding Scanner.PilihFolderCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" Height="36" Padding="11,4" Margin="0,0,8,0"
                        ToolTip="Pilih folder tertentu untuk dipindai" />
                <Button Grid.Column="4" Content="Pindai" Command="{Binding Scanner.MulaiPemindaianCommand}"
                        Style="{StaticResource PrimaryButtonStyle}" Height="36" Padding="15,4" Margin="0,0,8,0"
                        IsEnabled="{Binding Scanner.CanStartScan}"
                        AutomationProperties.Name="Pindai drive atau folder yang dipilih" />
                <Button Grid.Column="5" Content="Batal" Command="{Binding Scanner.BatalPemindaianCommand}"
                        Style="{StaticResource DangerButtonStyle}" Height="36" Padding="11,4"
                        Visibility="{Binding Scanner.IsScanning, Converter={StaticResource BoolToVis}}" />
                <Button Grid.Column="6" Command="{Binding RestartAsAdminCommand}" Style="{StaticResource AdminElevateButtonStyle}"
                        Height="36" Padding="10,4" Margin="8,0,0,0"
                        Visibility="{Binding CanElevate, Converter={StaticResource BoolToVis}}"
                        ToolTip="Mulai ulang dengan hak administrator melalui UAC"
                        AutomationProperties.Name="Mulai ulang ROOT sebagai administrator">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7EF;" FontFamily="Segoe MDL2 Assets" Margin="0,0,5,0" />
                        <TextBlock Text="Admin" FontSize="11" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Status ringkas; kesalahan parsial dan kemajuan tetap terlihat saat bekerja. -->
        <Border Grid.Row="2" Background="{DynamicResource BrushDarkBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="0,0,0,1" Padding="16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" MinWidth="0">
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource BrushAccentGreen}" Margin="0,0,7,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Scanner.StatusText}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </StackPanel>
                <ProgressBar Grid.Column="1" Width="74" Height="5" Margin="12,0" VerticalAlignment="Center"
                             IsIndeterminate="{Binding Scanner.IsScanning}" Visibility="{Binding Scanner.IsScanning, Converter={StaticResource BoolToVis}}"
                             Style="{StaticResource RootProgressBarStyle}" />
                <TextBlock Grid.Column="2" Text="{Binding Scanner.ScannedFiles, StringFormat={}{0:N0} berkas}" FontSize="10"
                           Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center" Margin="8,0" />
                <TextBlock Grid.Column="3" Text="{Binding Scanner.SkippedCount, StringFormat={}{0:N0} dilewati}" FontSize="10"
                           Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center" Margin="8,0" />
                <TextBlock Grid.Column="4" Text="{Binding Scanner.FormattedTotalBytes}" FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" Margin="8,0,0,0" />
            </Grid>
        </Border>

        <ContentControl x:Name="MainContent" Grid.Row="3" Content="{Binding CurrentView, NotifyOnTargetUpdated=True}"
                        TargetUpdated="MainContent_TargetUpdated" Margin="14,12" RenderTransformOrigin="0.5,0.5">
            <ContentControl.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1" /></ContentControl.RenderTransform>
        </ContentControl>

    </Grid>
</Window>
