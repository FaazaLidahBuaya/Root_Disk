<UserControl x:Class="Root.App.Views.CleanupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Root.App.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:CleanupViewModel}"
             Foreground="{StaticResource BrushTextPrimary}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,10,20">

            <!-- KARTU 1: KONFIGURASI DAN SUMBER ANALISIS -->
            <Border Style="{StaticResource RootCardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Analisis Kandidat Pembersihan Konservatif" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource BrushAccentAmber}" />
                            <TextBlock Text="Mengidentifikasi berkas sementara lama, crash dump, dan unduhan terhenti tanpa mengorbankan keamanan sistem." 
                                       FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0" />
                        </StackPanel>

                        <!-- Tombol Aksi Utama -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Mulai Analisis" Command="{Binding MulaiAnalisisCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}" Height="38" Margin="0,0,8,0" />
                            <Button Content="Batal" Command="{Binding BatalOperasiCommand}" 
                                    Style="{StaticResource DangerButtonStyle}" Height="38" Margin="0,0,8,0" />
                            <Button Content="Salin Laporan Audit" Command="{Binding SalinLaporanAuditCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" Height="38" />
                        </StackPanel>
                    </Grid>

                    <!-- Pilihan Sumber Berkas -->
                    <Border Background="#FFFFFF" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="SUMBER ANALISIS PENYIMPANAN" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,8" />

                            <RadioButton IsChecked="{Binding UseCurrentScanData}" GroupName="CleanupSource" Margin="0,0,0,8"
                                         IsEnabled="{Binding HasScanData}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Gunakan Data Hasil Pemindaian Aktif" FontWeight="Medium" Foreground="{StaticResource BrushTextPrimary}" />
                                    <TextBlock Text=" (Analisis cepat berbasis pohon pemindaian)" FontSize="11" Foreground="{StaticResource BrushAccentCyan}" Margin="6,0,0,0" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton IsChecked="{Binding UseCurrentScanData, Converter={x:Null}}" GroupName="CleanupSource">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Pilih Folder Disk Khusus: " FontWeight="Medium" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center" />
                                    <TextBox Text="{Binding TargetDirectoryPath, UpdateSourceTrigger=PropertyChanged}" Width="380" Height="30" Margin="8,0,8,0" 
                                             Style="{StaticResource SearchTextBoxStyle}" VerticalContentAlignment="Center" />
                                    <Button Content="Telusuri..." Command="{Binding PilihFolderCommand}" Style="{StaticResource SecondaryButtonStyle}" Height="30" Padding="12,4" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </Border>

                    <!-- Peringatan Keamanan Konservatif -->
                    <Border Background="#FFF9EC" BorderBrush="{StaticResource BrushAccentAmber}" BorderThickness="1" CornerRadius="6" Padding="12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource BrushAccentAmber}" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Text="Prinsip Konservatif ROOT: Berkas sistem (Windows, Program Files), executable, cache aktif, dan berkas yang dimodifikasi kurang dari 14 hari terlindungi secara otomatis dan TIDAK akan dimasukkan ke kandidat pembersihan." 
                                       FontSize="11" Foreground="#8A5A00" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- KARTU 2: INDIKATOR PROGRES WAKTU NYATA & METRIK -->
            <Border Style="{StaticResource RootCardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Status: " FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" />
                            <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" />
                        </StackPanel>

                        <Border Grid.Column="1" Background="#EEF4FF" CornerRadius="4" Padding="8,4"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text=" MEMPROSES" FontSize="11" FontWeight="Bold" Foreground="#1D4ED8" />
                        </Border>
                    </Grid>

                    <ProgressBar Value="{Binding ProgressPercentage}" Maximum="100" Height="6" Margin="0,0,0,10" 
                                 Style="{StaticResource RootProgressBarStyle}" />

                    <DockPanel LastChildFill="True" Margin="0,0,0,12">
                        <TextBlock Text="Target: " Foreground="{StaticResource BrushTextMuted}" FontWeight="SemiBold" DockPanel.Dock="Left" FontSize="12" />
                        <TextBlock Text="{Binding CurrentProcessingFile}" Foreground="{StaticResource BrushAccentCyan}" 
                                   FontFamily="{StaticResource FontMono}" FontSize="12" TextTrimming="CharacterEllipsis" />
                    </DockPanel>

                    <!-- 4 Kartu Metrik Ringkasan -->
                    <UniformGrid Columns="4" Rows="1" Margin="-4">
                        <Border Background="#FFFFFF" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="4">
                            <StackPanel>
                                <TextBlock Text="KANDIDAT TERIDENTIFIKASI" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" />
                                <TextBlock Text="{Binding TotalCandidatesCount, StringFormat='{}{0:N0} berkas'}" 
                                           FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Background="#FFFFFF" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="4">
                            <StackPanel>
                                <TextBlock Text="POTENSI RUANG DIBEBASKAN" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" />
                                <TextBlock Text="{Binding FormattedTotalPotentialSize}" 
                                           FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrushAccentGreen}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Background="#FFFFFF" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="4">
                            <StackPanel>
                                <TextBlock Text="BERKAS TERPILIH" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" />
                                <TextBlock Text="{Binding SelectedCount, StringFormat='{}{0:N0} berkas'}" 
                                           FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrushAccentAmber}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Background="#FFFFFF" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="4">
                            <StackPanel>
                                <TextBlock Text="RUANG AKAN DIBEBASKAN" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" />
                                <TextBlock Text="{Binding FormattedSelectedFreedSpace}" 
                                           FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrushAccentRose}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- KARTU 3: DAFTAR KANDIDAT & AKSI PEMBERSIHAN TERKONTROL -->
            <Border Style="{StaticResource RootCardStyle}">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Daftar Kandidat Pembersihan (Pratinjau Sebelum Tindakan)" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" />
                            <TextBlock Text="Pilih berkas yang ingin dibersihkan. Setiap target akan diverifikasi ulang sebelum tindakan penghapusan." 
                                       FontSize="12" Foreground="{StaticResource BrushTextMuted}" Margin="0,2,0,0" />
                        </StackPanel>

                        <!-- Tombol Aksi Pembersihan -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Pilih Semua Aman" Command="{Binding PilihSemuaAmanCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" Height="34" Margin="0,0,8,0" />
                            <Button Content="Batalkan Pilihan" Command="{Binding BatalkanSemuaPilihanCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" Height="34" Margin="0,0,12,0" />
                            <Button Content="Bersihkan Berkas Terpilih" Command="{Binding BersihkanTerpilihCommand}"
                                    Style="{StaticResource DangerButtonStyle}" Height="34" FontWeight="Bold" />
                        </StackPanel>
                    </Grid>

                    <!-- DataGrid Kandidat -->
                    <DataGrid ItemsSource="{Binding Candidates}"
                              SelectedItem="{Binding SelectedCandidate}"
                              AutoGenerateColumns="False"
                              IsReadOnly="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              MaxHeight="450"
                              SelectionMode="Single"
                              Style="{StaticResource HierarchyDataGridStyle}">
                        <DataGrid.Columns>
                            <!-- CheckBox Pilih -->
                            <DataGridTemplateColumn Header="Pilih" Width="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" 
                                                  IsEnabled="{Binding CanBeSelected}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Kategori -->
                            <DataGridTextColumn Header="Kategori" Binding="{Binding CategoryName}" Width="160" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="Foreground" Value="{StaticResource BrushAccentCyan}" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Nama Berkas -->
                            <DataGridTextColumn Header="Nama Berkas" Binding="{Binding FileName}" Width="180" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Medium" />
                                        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Lokasi Lengkap -->
                            <DataGridTextColumn Header="Lokasi Lengkap" Binding="{Binding FullPath}" Width="*" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
                                        <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
                                        <Setter Property="FontSize" Value="11" />
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Ukuran -->
                            <DataGridTextColumn Header="Ukuran" Binding="{Binding FormattedSize}" Width="100" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Usia Berkas -->
                            <DataGridTextColumn Header="Usia" Binding="{Binding AgeDays, StringFormat='{}{0:N0} hari'}" Width="80" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}" />
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Tingkat Keamanan -->
                            <DataGridTextColumn Header="Tingkat Keamanan" Binding="{Binding SafetyLevelName}" Width="140" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="Foreground" Value="{StaticResource BrushAccentGreen}" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Alasan Konservatif -->
                            <DataGridTextColumn Header="Alasan Identifikasi" Binding="{Binding Reason}" Width="250" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
                                        <Setter Property="FontSize" Value="11" />
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Aksi Buka Lokasi -->
                            <DataGridTemplateColumn Header="Aksi" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Lokasi"
                                                Command="{Binding DataContext.BukaLokasiBerkasCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding FullPath}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Height="26" Padding="6,2" FontSize="11" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Status Data Kosong -->
                    <Border Background="#F7F8FC" CornerRadius="6" Padding="24" Margin="0,8,0,0"
                            Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text=" Belum ada analisis kandidat pembersihan." FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center" />
                            <TextBlock Text="Klik tombol 'Mulai Analisis' di atas untuk memindai berkas kandidat pembersihan konservatif secara aman." FontSize="12" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
