<UserControl x:Class="Root.App.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Root.App.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:AboutViewModel}"
             Foreground="{StaticResource BrushTextPrimary}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,10,20">
            <!-- HEADER LOGO & NAMA -->
            <Border Style="{StaticResource RootCardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Background="{StaticResource BrushAccentGreen}" CornerRadius="8" Width="44" Height="44" Margin="0,0,16,0">
                            <TextBlock Text="⚡" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#090D16" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="ROOT" FontSize="24" FontWeight="Bold" Foreground="{StaticResource BrushAccentGreen}" />
                            <TextBlock Text="{Binding Version, StringFormat='Versi: {0}'}" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="{Binding Description}" FontSize="14" Foreground="{StaticResource BrushTextSecondary}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- KARTU KEAMANAN & HAK ADMINISTRATOR -->
            <Border Style="{StaticResource RootCardStyle}" Margin="0,0,0,16" Background="#0C1322" BorderBrush="#1E3A8A">
                <StackPanel>
                    <TextBlock Text="🛡️ Status Hak Akses &amp; Jaminan Keamanan Sistem" FontSize="16" FontWeight="SemiBold" Foreground="#60A5FA" Margin="0,0,0,12" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Status Hak Akses Saat Ini: " Foreground="{StaticResource BrushTextSecondary}" FontSize="13" />
                        <TextBlock Text="{Binding AdminPrivilegeText}" FontWeight="Bold" FontSize="13" Foreground="#34D399" />
                    </StackPanel>
                    <TextBlock Text="{Binding SecurityGuarantee}" FontSize="12" Foreground="#93C5FD" LineHeight="20" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- KARTU INFORMASI FITUR ROOT -->
            <Border Style="{StaticResource RootCardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Cakupan Implementasi ROOT (Fase 1 - 4 Lengkap)" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource BrushAccentCyan}" Margin="0,0,0,12" />
                    <TextBlock Text="{Binding PhaseFeatures}" FontSize="13" Foreground="{StaticResource BrushTextPrimary}" LineHeight="22" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- KARTU LINGKUNGAN SISTEM -->
            <Border Style="{StaticResource RootCardStyle}">
                <StackPanel>
                    <TextBlock Text="Informasi Lingkungan Sistem" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource BrushAccentAmber}" Margin="0,0,0,14" />
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28" />
                            <RowDefinition Height="28" />
                            <RowDefinition Height="28" />
                            <RowDefinition Height="28" />
                            <RowDefinition Height="28" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Sistem Operasi:" Foreground="{StaticResource BrushTextSecondary}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding OsVersion}" FontWeight="Medium" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Runtime .NET:" Foreground="{StaticResource BrushTextSecondary}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DotNetVersion}" FontWeight="Medium" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Jumlah Logis CPU:" Foreground="{StaticResource BrushTextSecondary}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ProcessorCount, StringFormat='{}{0} core'}" FontWeight="Medium" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Nama Perangkat:" Foreground="{StaticResource BrushTextSecondary}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding MachineName}" FontWeight="Medium" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Pengguna Aktif:" Foreground="{StaticResource BrushTextSecondary}" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding UserName}" FontWeight="Medium" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
