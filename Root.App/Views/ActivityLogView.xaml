<UserControl x:Class="Root.App.Views.ActivityLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Root.App.ViewModels"
             xmlns:m="clr-namespace:Root.Core.Models;assembly=Root.Core"
             xmlns:conv="clr-namespace:Root.App.Converters"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:ActivityLogViewModel}"
             Foreground="{StaticResource BrushTextPrimary}">

    <UserControl.Resources>
        <conv:LogLevelToBrushConverter x:Key="LogLevelToBrush" />
    </UserControl.Resources>

    <Grid Margin="0,0,10,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- BARIS KONTROL & FILTER -->
        <Border Style="{StaticResource RootCardStyle}" Margin="0,0,0,14" Grid.Row="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Filter Level & Pencarian -->
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Filter:" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    
                    <ComboBox SelectedValue="{Binding SelectedFilter}" SelectedValuePath="Tag" Width="140" Height="36" Style="{StaticResource RootComboBoxStyle}" Margin="0,0,16,0">
                        <ComboBoxItem Content="Semua Level" Tag="{x:Static m:LogLevel.Semua}" IsSelected="True" />
                        <ComboBoxItem Content="Info" Tag="{x:Static m:LogLevel.Info}" />
                        <ComboBoxItem Content="Sukses" Tag="{x:Static m:LogLevel.Sukses}" />
                        <ComboBoxItem Content="Peringatan" Tag="{x:Static m:LogLevel.Peringatan}" />
                        <ComboBoxItem Content="Kesalahan" Tag="{x:Static m:LogLevel.Kesalahan}" />
                    </ComboBox>

                    <TextBlock Text="Cari:" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Width="220" Height="36" 
                             Style="{StaticResource RootTextBoxStyle}" VerticalContentAlignment="Center" />
                </WrapPanel>

                <!-- Tombol Aksi -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="📋 Salin Semua" Command="{Binding SalinSemuaCommand}" Style="{StaticResource SecondaryButtonStyle}" Height="36" Margin="0,0,8,0" />
                    <Button Content="💾 Ekspor Log..." Command="{Binding EksporLogCommand}" Style="{StaticResource SecondaryButtonStyle}" Height="36" Margin="0,0,8,0" />
                    <Button Content="🗑️ Bersihkan" Command="{Binding BersihkanLogCommand}" Style="{StaticResource SecondaryButtonStyle}" Height="36" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- DAFTAR CATATAN AKTIVITAS -->
        <Border Style="{StaticResource RootCardStyle}" Grid.Row="1" Padding="0">
            <DataGrid ItemsSource="{Binding FilteredLogs}" AutoGenerateColumns="False" 
                      CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column"
                      Background="#0F172A" RowBackground="#0F172A" AlternatingRowBackground="#1E293B"
                      Foreground="{StaticResource BrushTextPrimary}" BorderThickness="0"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#334155">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Waktu" Binding="{Binding FormattedTime}" Width="110" FontFamily="{StaticResource FontMono}" />
                    
                    <DataGridTemplateColumn Header="Tingkat" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="#1E293B" BorderBrush="{Binding Level, Converter={StaticResource LogLevelToBrush}}" BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding LevelText}" Foreground="{Binding Level, Converter={StaticResource LogLevelToBrush}}" FontWeight="Bold" FontSize="11" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Pesan Aktivitas" Binding="{Binding Message}" Width="450" FontWeight="Medium" />
                    <DataGridTextColumn Header="Rincian Tambahan" Binding="{Binding Details}" Width="*" FontFamily="{StaticResource FontMono}" Foreground="#94A3B8" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
