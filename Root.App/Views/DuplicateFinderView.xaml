<UserControl x:Class="Root.App.Views.DuplicateFinderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Root.App.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:DuplicateFinderViewModel}"
             Foreground="{StaticResource BrushTextPrimary}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,10,20">

            <!-- KARTU 1: KONFIGURASI DAN SUMBER PENCARIAN -->
            <Border Style="{StaticResource RootCardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Pencari Berkas Duplikat (SHA-256)" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource BrushAccentGreen}" />
                            <TextBlock Text="Mendeteksi berkas dengan ukuran identik dan memverifikasi isi menggunakan hash kriptografi SHA-256." 
                                       FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0" />
                        </StackPanel>

                        <!-- Tombol Aksi Utama -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="⚡ Mulai Pencarian" Command="{Binding MulaiPencarianCommand}" 
                                    Style="{StaticResource PrimaryButtonStyle}" Height="38" Margin="0,0,8,0" />
                            <Button Content="Batal" Command="{Binding BatalPencarianCommand}" 
                                    Style="{StaticResource DangerButtonStyle}" Height="38" Margin="0,0,8,0" />
                            <Button Content="📋 Salin Laporan" Command="{Binding SalinLaporanCommand}" 
                                    Style="{StaticResource SecondaryButtonStyle}" Height="38" />
                        </StackPanel>
                    </Grid>

                    <!-- Pilihan Sumber Berkas -->
                    <Border Background="#0F172A" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="SUMBER ANALISIS BERKAS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,8" />

                            <RadioButton IsChecked="{Binding UseCurrentScanData}" GroupName="SourceSelection" Margin="0,0,0,8"
                                         IsEnabled="{Binding HasScanDataAvailable}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Gunakan Data Pemindaian Aktif" FontWeight="Medium" Foreground="{StaticResource BrushTextPrimary}" />
                                    <TextBlock Text=" (Analisis instan dari memori tanpa pemindaian ulang)" FontSize="11" Foreground="{StaticResource BrushAccentCyan}" Margin="6,0,0,0" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton IsChecked="{Binding UseCurrentScanData, Converter={x:Null}}" GroupName="SourceSelection">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Pilih Direktori Sistem Khusus: " FontWeight="Medium" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center" />
                                    <TextBox Text="{Binding TargetDirectoryPath, UpdateSourceTrigger=PropertyChanged}" Width="380" Height="30" Margin="8,0,8,0" 
                                             Style="{StaticResource SearchTextBoxStyle}" VerticalContentAlignment="Center" />
                                    <Button Content="Telusuri..." Command="{Binding PilihFolderCommand}" Style="{StaticResource SecondaryButtonStyle}" Height="30" Padding="12,4" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </Border>

                    <!-- Opsi Tambahan -->
                    <StackPanel Orientation="Horizontal" Margin="4,0,0,0">
                        <CheckBox IsChecked="{Binding IncludeZeroByteFiles}" VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock Text="Sertakan Berkas Kosong (0-byte)" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" />
                        </CheckBox>
                        <TextBlock Text="💡 Berkas 0-byte ditangani secara khusus dan tidak menghabiskan kuota ruang terbuang." FontSize="11" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" Margin="12,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- KARTU 2: INDIKATOR PROGRES WAKTU NYATA -->
            <Border Style="{StaticResource RootCardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Status: " FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" />
                            <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" />
                        </StackPanel>

                        <Border Grid.Column="1" Background="#1E3A8A" CornerRadius="4" Padding="8,4" 
                                Visibility="{Binding IsSearching, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="⚡ MENGANALISIS HASH" FontSize="11" FontWeight="Bold" Foreground="#60A5FA" />
                        </Border>
                    </Grid>

                    <ProgressBar Value="{Binding ProgressPercentage}" Maximum="100" Height="6" Margin="0,0,0,10" 
                                 Style="{StaticResource RootProgressBarStyle}" />

                    <DockPanel LastChildFill="True" Margin="0,0,0,12">
                        <TextBlock Text="Sedang Memeriksa: " Foreground="{StaticResource BrushTextMuted}" FontWeight="SemiBold" DockPanel.Dock="Left" FontSize="12" />
                        <TextBlock Text="{Binding CurrentProcessingFile}" Foreground="{StaticResource BrushAccentCyan}" 
                                   FontFamily="{StaticResource FontMono}" FontSize="12" TextTrimming="CharacterEllipsis" />
                    </DockPanel>

                    <!-- 4 Kartu Metrik Ringkasan -->
                    <UniformGrid Columns="4" Rows="1" Margin="-4">
                        <Border Background="#0F172A" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="4">
                            <StackPanel>
                                <TextBlock Text="KELOMPOK DUPLIKAT" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" />
                                <TextBlock Text="{Binding SearchResult.TotalDuplicateGroups, StringFormat='{}{0:N0} grup', FallbackValue='0 grup'}" 
                                           FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Background="#0F172A" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="4">
                            <StackPanel>
                                <TextBlock Text="TOTAL BERKAS DUPLIKAT" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" />
                                <TextBlock Text="{Binding SearchResult.TotalDuplicateFiles, StringFormat='{}{0:N0} berkas', FallbackValue='0 berkas'}" 
                                           FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrushAccentCyan}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Background="#0F172A" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="4">
                            <StackPanel>
                                <TextBlock Text="POTENSI PENGHEMATAN" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" />
                                <TextBlock Text="{Binding SearchResult.FormattedTotalWaste, FallbackValue='0 B'}" 
                                           FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrushAccentGreen}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Background="#0F172A" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="4">
                            <StackPanel>
                                <TextBlock Text="KECEPATAN STREAM HASH" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" />
                                <TextBlock Text="{Binding ThroughputText}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrushAccentAmber}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- KARTU 3: MASTER-DETAIL TEMUAN DUPLIKAT -->
            <Border Style="{StaticResource RootCardStyle}" Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="460" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Daftar Temuan Berkas Duplikat Identik" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />

                    <!-- Tampilan Terpisah: Kiri (Kelompok Duplikat), Kanan (Rincian Berkas Identik) -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="420" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Tabel Kiri: Kelompok Duplikat -->
                        <Border Grid.Column="0" Background="#0F172A" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="36" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Background="#1E293B" Padding="12,8">
                                    <TextBlock Text="Kelompok Duplikat (Urut Pemborosan)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" />
                                </Border>

                                <DataGrid Grid.Row="1" ItemsSource="{Binding DuplicateGroups}" SelectedItem="{Binding SelectedGroup}"
                                          AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column"
                                          Background="Transparent" RowBackground="#0F172A" AlternatingRowBackground="#162032"
                                          Foreground="{StaticResource BrushTextPrimary}" BorderThickness="0"
                                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#334155" SelectionMode="Single">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Ukuran" Binding="{Binding FormattedFileSize}" Width="85" FontWeight="SemiBold" Foreground="#38BDF8" />
                                        <DataGridTextColumn Header="Salinan" Binding="{Binding FileCount, StringFormat='{}{0}x'}" Width="65" FontWeight="Bold" Foreground="{StaticResource BrushAccentCyan}" />
                                        <DataGridTextColumn Header="Pemborosan" Binding="{Binding FormattedWasteSize}" Width="95" FontWeight="Bold" Foreground="{StaticResource BrushAccentGreen}" />
                                        <DataGridTextColumn Header="Hash SHA-256" Binding="{Binding ShortHash}" Width="*" FontFamily="{StaticResource FontMono}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" Background="Transparent" />

                        <!-- Tabel Kanan: Rincian Berkas dalam Kelompok yang Dipilih -->
                        <Border Grid.Column="2" Background="#0F172A" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Background="#1E293B" Padding="14,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Berkas Identik" FontSize="13" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" />
                                                <TextBlock Text="{Binding SelectedGroup.FileCount, StringFormat=' ({0} lokasi)'}" FontSize="13" Foreground="{StaticResource BrushAccentCyan}" FontWeight="SemiBold" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding SelectedGroup.Sha256Hash, StringFormat='Full SHA-256: {0}'}" 
                                                       FontFamily="{StaticResource FontMono}" FontSize="10" Foreground="{StaticResource BrushTextMuted}" Margin="0,2,0,0" />
                                        </StackPanel>

                                        <Border Grid.Column="1" Background="#064E3B" BorderBrush="#059669" BorderThickness="1" CornerRadius="4" Padding="8,4">
                                            <TextBlock Text="Isi 100% Identik" FontSize="11" FontWeight="Bold" Foreground="#34D399" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <DataGrid Grid.Row="1" ItemsSource="{Binding SelectedGroup.Files}"
                                          AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column"
                                          Background="Transparent" RowBackground="#0F172A" AlternatingRowBackground="#162032"
                                          Foreground="{StaticResource BrushTextPrimary}" BorderThickness="0"
                                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#334155">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Nama Berkas" Binding="{Binding FileName}" Width="200" FontWeight="Medium" />
                                        <DataGridTextColumn Header="Jalur Lengkap" Binding="{Binding FullPath}" Width="*" />
                                        <DataGridTextColumn Header="Terakhir Diubah" Binding="{Binding FormattedLastModified}" Width="150" />
                                        <DataGridTemplateColumn Header="Aksi" Width="100">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="📂 Buka Lokasi" 
                                                            Command="{Binding DataContext.BukaLokasiBerkasCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding FullPath}"
                                                            Style="{StaticResource SecondaryButtonStyle}" Height="26" Padding="6,2" FontSize="11" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
