<UserControl x:Class="Root.App.Views.TreemapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Root.App.ViewModels"
             xmlns:m="clr-namespace:Root.Core.Models;assembly=Root.Core"
             xmlns:conv="clr-namespace:Root.App.Converters"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:TreemapViewModel}"
             Foreground="{DynamicResource BrushTextPrimary}">

    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:BooleanToVisibilityConverter x:Key="InvertBoolToVis" Invert="True" />
        <conv:NullToVisibilityConverter x:Key="NullToVis" />
        <conv:HexToBrushConverter x:Key="HexToBrush" />
        <conv:DimensionToVisibilityConverter x:Key="DimToVis" MinWidth="50" MinHeight="26" />
        <conv:DimensionToVisibilityConverter x:Key="DimToVisLarge" MinWidth="65" MinHeight="42" />
        <conv:DimensionToVisibilityConverter x:Key="DimToVisIcon" MinWidth="80" MinHeight="64" />
    </UserControl.Resources>

    <Grid Margin="0,0,10,10">
        <Grid.RowDefinitions>
            <!-- Baris 1: Bilah Navigasi & Jejak Lokasi (Breadcrumb) -->
            <RowDefinition Height="Auto" />
            <!-- Baris 2: Kanvas Treemap Interaktif -->
            <RowDefinition Height="*" />
            <!-- Baris 3: Panel Rincian Kotak Terpilih (Inspector) -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- BARIS 1: BILAH NAVIGASI & JEJAK LOKASI (BREADCRUMB) -->
        <Border Grid.Row="0" Style="{StaticResource RootCardStyle}" Margin="0,0,0,12" Padding="12,10">
            <StackPanel>
                <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Tombol Kembali / Naik Satu Tingkat -->
                <Button Grid.Column="0" Content="Ke Folder Induk" Command="{Binding NavigateUpCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" Height="34" Padding="12,4" Margin="0,0,12,0" />

                <!-- Jejak Lokasi Folder (Breadcrumb) -->
                <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" VerticalAlignment="Center">
                    <ItemsControl ItemsSource="{Binding Breadcrumbs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="{Binding Name}" 
                                            Command="{Binding DataContext.NavigateToBreadcrumbCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                            CommandParameter="{Binding}"
                                            Cursor="Hand" Margin="2,0">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="{DynamicResource BrushInputBg}" />
                                                <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource BrushCardBorder}" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Setter Property="Padding" Value="8,4" />
                                                <Setter Property="FontSize" Value="12" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter VerticalAlignment="Center" />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource BrushHoverSurface}" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
                                                                </Trigger>
                                                                <DataTrigger Binding="{Binding IsLast}" Value="True">
                                                                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource BrushAccentGreen}" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource BrushAccentGreen}" />
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                </DataTrigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <!-- Tanda Pemisah -->
                                    <TextBlock Text="›" Foreground="{DynamicResource BrushTextMuted}" FontSize="14" VerticalAlignment="Center" Margin="2,0"
                                               Visibility="{Binding IsLast, Converter={StaticResource InvertBoolToVis}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Ringkasan Folder Saat Ini -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="4" Padding="10,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding CurrentFolder.FormattedSize}" FontWeight="Bold" Foreground="{DynamicResource BrushAccentGreen}" FontSize="12" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding CurrentFolder.TotalSubItems, StringFormat='({0} item)'}" Foreground="{DynamicResource BrushTextMuted}" FontSize="12" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Bilah Filter & Pengurutan Treemap -->
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,10,0,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,6">
                    <TextBlock Text="Disk:" Foreground="{DynamicResource BrushTextSecondary}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox Width="190" Height="32" Style="{StaticResource RootComboBoxStyle}"
                              ItemsSource="{Binding DataContext.Scanner.Drives, RelativeSource={RelativeSource AncestorType=Window}}"
                              SelectedItem="{Binding DataContext.Scanner.SelectedDrive, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                              ToolTip="{Binding DataContext.Scanner.SelectedDrive.DisplayName, RelativeSource={RelativeSource AncestorType=Window}}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource BrushTextPrimary}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Content="Pindai" Style="{StaticResource PrimaryButtonStyle}" Height="32" Padding="12,3" Margin="7,0,0,0"
                            Command="{Binding DataContext.Scanner.MulaiPemindaianCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            IsEnabled="{Binding DataContext.Scanner.CanStartScan, RelativeSource={RelativeSource AncestorType=Window}}" />
                </StackPanel>
                <TextBlock Text="{Binding DataContext.Scanner.StatusText, RelativeSource={RelativeSource AncestorType=Window}}"
                           Visibility="{Binding DataContext.Scanner.IsScanning, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"
                           Foreground="{DynamicResource BrushTextMuted}" FontSize="10" VerticalAlignment="Center" Margin="0,0,14,6"
                           Width="150" TextTrimming="CharacterEllipsis" />
                <!-- Urutkan Berdasarkan -->
                <TextBlock Text="Urutkan:" Foreground="{DynamicResource BrushTextSecondary}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox SelectedValue="{Binding SelectedSortField}" SelectedValuePath="Tag" Width="120" Height="32" Style="{StaticResource RootComboBoxStyle}" Margin="0,0,8,0">
                    <ComboBoxItem Content="Ukuran" Tag="{x:Static m:SortField.Ukuran}" IsSelected="True" />
                    <ComboBoxItem Content="Nama" Tag="{x:Static m:SortField.Nama}" />
                    <ComboBoxItem Content="Tanggal Diubah" Tag="{x:Static m:SortField.TanggalDiubah}" />
                </ComboBox>

                <ComboBox SelectedValue="{Binding SelectedSortDirection}" SelectedValuePath="Tag" Width="100" Height="32" Style="{StaticResource RootComboBoxStyle}" Margin="0,0,14,0">
                    <ComboBoxItem Content="Menurun" Tag="{x:Static m:SortDirection.Menurun}" IsSelected="True" />
                    <ComboBoxItem Content="Menaik" Tag="{x:Static m:SortDirection.Menaik}" />
                </ComboBox>

                <!-- Ekstensi -->
                <TextBlock Text="Ekstensi:" Foreground="{DynamicResource BrushTextSecondary}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox Text="{Binding FilterExtension, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" Width="105" Height="32" Style="{StaticResource RootComboBoxStyle}" Margin="0,0,14,0">
                    <ComboBoxItem Content="Semua" IsSelected="True" />
                    <ComboBoxItem Content=".exe" />
                    <ComboBoxItem Content=".dll" />
                    <ComboBoxItem Content=".mp4" />
                    <ComboBoxItem Content=".mkv" />
                    <ComboBoxItem Content=".zip" />
                    <ComboBoxItem Content=".rar" />
                    <ComboBoxItem Content=".pdf" />
                    <ComboBoxItem Content=".docx" />
                    <ComboBoxItem Content=".iso" />
                </ComboBox>

                <!-- Cari Nama -->
                <TextBlock Text="Cari:" Foreground="{DynamicResource BrushTextSecondary}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Width="120" Height="32" Style="{StaticResource RootTextBoxStyle}" Margin="0,0,12,0" VerticalContentAlignment="Center" />

                <!-- Tombol Reset -->
                <Button Content="Reset Filter" Command="{Binding ResetFilterCommand}" Style="{StaticResource SecondaryButtonStyle}" Height="32" Padding="10,2" />
            </WrapPanel>
            </StackPanel>
        </Border>

        <!-- BARIS 2: KANVAS TREEMAP INTERAKTIF -->
        <Border Grid.Row="1" x:Name="TreemapBorder" Style="{StaticResource RootCardStyle}" Padding="2"
                SizeChanged="TreemapBorder_SizeChanged" ClipToBounds="True">
            <Grid>
                <!-- KONDISI A: BELUM ADA DATA PEMINDAIAN -->
                <Border Background="{DynamicResource BrushCardBg}" CornerRadius="6" Visibility="{Binding HasData, Converter={StaticResource InvertBoolToVis}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
                        <Border Background="{DynamicResource BrushInputBg}" CornerRadius="12" Width="64" Height="64" HorizontalAlignment="Center" Margin="0,0,0,16">
                            <TextBlock Text="&#xE80A;" FontFamily="Segoe MDL2 Assets" FontSize="32" Foreground="{DynamicResource BrushAccentGreen}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Belum Ada Data Pemindaian" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,8" />
                        <TextBlock Text="Pilih disk di bilah atas lalu tekan Pindai untuk membuat peta dari isi penyimpanan yang sebenarnya."
                                   FontSize="13" Foreground="{DynamicResource BrushTextSecondary}" TextAlignment="Center" TextWrapping="Wrap" LineHeight="20" />
                    </StackPanel>
                </Border>

                <!-- KONDISI B: FOLDER KOSONG (0 BERKAS) -->
                <Border Background="{DynamicResource BrushCardBg}" CornerRadius="6" Visibility="{Binding IsEmptyFolder, Converter={StaticResource BoolToVis}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="36" Foreground="{DynamicResource BrushAccentGreen}" HorizontalAlignment="Center" Margin="0,0,0,12" />
                        <TextBlock Text="Folder ini kosong" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource BrushTextSecondary}" />
                        <TextBlock Text="Tidak ada berkas atau subdirektori di dalam folder ini." FontSize="12" Foreground="{DynamicResource BrushTextMuted}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- KONDISI C: KANVAS TREEMAP AKTIF -->
                <ItemsControl x:Name="TreemapItems" ItemsSource="{Binding Nodes}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas Background="Transparent" ClipToBounds="True" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding X}" />
                            <Setter Property="Canvas.Top" Value="{Binding Y}" />
                            <Setter Property="Width" Value="{Binding Width}" />
                            <Setter Property="Height" Value="{Binding Height}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="BoxBorder"
                                    BorderBrush="{DynamicResource BrushCardBg}" BorderThickness="1"
                                    Background="{Binding ColorHex, Converter={StaticResource HexToBrush}}"
                                    CornerRadius="4" Cursor="Hand" Margin="1"
                                    RenderTransformOrigin="0.5,0.5" Loaded="TreemapBox_Loaded"
                                    MouseLeftButtonDown="TreemapBox_MouseLeftButtonDown"
                                    MouseEnter="TreemapBox_MouseEnter"
                                    MouseLeave="TreemapBox_MouseLeave">
                                <Border.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1" /></Border.RenderTransform>

                                <!-- Tooltip Waktu Nyata Saat Penunjuk di Atas Kotak -->
                                <Border.ToolTip>
                                    <ToolTip Background="{DynamicResource BrushPopupSurface}" BorderBrush="{DynamicResource BrushAccentCyan}" BorderThickness="1" Padding="12">
                                        <StackPanel MaxWidth="360">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock Text="{Binding IsDirectory, Converter={StaticResource BoolToVis}}" />
                                                <TextBlock Text="&#xE8B7; " FontFamily="Segoe MDL2 Assets" Visibility="{Binding IsDirectory, Converter={StaticResource BoolToVis}}" FontSize="14" Foreground="{DynamicResource BrushAccentGreen}" />
                                                <TextBlock Text="&#xE8A5; " FontFamily="Segoe MDL2 Assets" Visibility="{Binding IsDirectory, Converter={StaticResource InvertBoolToVis}}" FontSize="14" Foreground="{DynamicResource BrushAccentCyan}" />
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Ukuran: " Foreground="{DynamicResource BrushTextMuted}" FontSize="12" />
                                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding FormattedSize}" Foreground="{DynamicResource BrushAccentGreen}" FontWeight="Bold" FontSize="12" />

                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Proporsi: " Foreground="{DynamicResource BrushTextMuted}" FontSize="12" />
                                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FormattedPercentage, StringFormat='{}{0} dari folder'}" Foreground="{DynamicResource BrushAccentCyan}" FontWeight="SemiBold" FontSize="12" />

                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Tipe: " Foreground="{DynamicResource BrushTextMuted}" FontSize="12" />
                                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TypeDescription}" Foreground="{DynamicResource BrushTextSecondary}" FontSize="12" />
                                            </Grid>

                                            <TextBlock Text="{Binding FullPath, StringFormat='Jalur: {0}'}" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11" FontFamily="{StaticResource FontMono}" TextWrapping="Wrap" Margin="0,0,0,8"
                                                       Visibility="{Binding IsAggregate, Converter={StaticResource InvertBoolToVis}}" />

                                            <Border Background="{DynamicResource BrushHoverSurface}" CornerRadius="4" Padding="6,3" HorizontalAlignment="Left" Visibility="{Binding IsDirectory, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="Klik untuk memilih • Klik 2x untuk masuk folder" Foreground="{DynamicResource BrushTextSecondary}" FontSize="10" FontWeight="SemiBold" />
                                            </Border>
                                        </StackPanel>
                                    </ToolTip>
                                </Border.ToolTip>

                                <!-- Label Teks di Dalam Kotak (Tampil jika kotak cukup besar) -->
                                <Grid Margin="3" ClipToBounds="True">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="22" HorizontalAlignment="Center" Margin="0,0,0,5"
                                                   RenderTransformOrigin="0.5,0.5">
                                            <TextBlock.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1" /></TextBlock.RenderTransform>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="&#xE8B7;" />
                                                    <Setter Property="Foreground" Value="#6254EA" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDirectory}" Value="False">
                                                            <Setter Property="Text" Value="&#xE8A5;" />
                                                            <Setter Property="Foreground" Value="#438BE8" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsAggregate}" Value="True">
                                                            <Setter Property="Text" Value="&#xE8B7;" />
                                                            <Setter Property="Foreground" Value="#6254EA" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                            <TextBlock.Visibility>
                                                <MultiBinding Converter="{StaticResource DimToVisIcon}">
                                                    <Binding Path="Width" />
                                                    <Binding Path="Height" />
                                                </MultiBinding>
                                            </TextBlock.Visibility>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Name}" Foreground="#263451" FontWeight="SemiBold" FontSize="11"
                                                   TextTrimming="CharacterEllipsis" TextAlignment="Center">
                                            <TextBlock.Visibility>
                                                <MultiBinding Converter="{StaticResource DimToVis}">
                                                    <Binding Path="Width" />
                                                    <Binding Path="Height" />
                                                </MultiBinding>
                                            </TextBlock.Visibility>
                                        </TextBlock>

                                        <TextBlock Text="{Binding FormattedSize}" Foreground="#52617E" FontSize="10"
                                                   TextAlignment="Center" Opacity="0.9">
                                            <TextBlock.Visibility>
                                                <MultiBinding Converter="{StaticResource DimToVisLarge}">
                                                    <Binding Path="Width" />
                                                    <Binding Path="Height" />
                                                </MultiBinding>
                                            </TextBlock.Visibility>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </Border>

                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <!-- BARIS 3: PANEL RINCIAN KOTAK TERPILIH (INSPECTOR) -->
        <Border Grid.Row="2" Style="{StaticResource RootCardStyle}" Margin="0,12,0,0" Padding="14,12"
                Visibility="{Binding SelectedNode, Converter={StaticResource NullToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Rincian Item Terpilih -->
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Border Background="{DynamicResource BrushAccentCyan}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding SelectedNode.TypeDescription}" FontWeight="Bold" FontSize="11" Foreground="#202B45" />
                        </Border>
                        <TextBlock Text="{Binding SelectedNode.Name}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <WrapPanel Orientation="Horizontal">
                        <TextBlock Text="Ukuran: " Foreground="{DynamicResource BrushTextMuted}" FontSize="12" />
                        <TextBlock Text="{Binding SelectedNode.FormattedSize}" FontWeight="Bold" Foreground="{DynamicResource BrushAccentGreen}" FontSize="12" Margin="0,0,16,0" />

                        <TextBlock Text="Proporsi: " Foreground="{DynamicResource BrushTextMuted}" FontSize="12" />
                        <TextBlock Text="{Binding SelectedNode.FormattedPercentage}" FontWeight="SemiBold" Foreground="{DynamicResource BrushAccentCyan}" FontSize="12" Margin="0,0,16,0" />

                        <TextBlock Text="Jalur: " Foreground="{DynamicResource BrushTextMuted}" FontSize="12" />
                        <TextBlock Text="{Binding SelectedNode.FullPath}" Foreground="{DynamicResource BrushTextSecondary}" FontSize="12" FontFamily="{StaticResource FontMono}" TextTrimming="CharacterEllipsis" />
                    </WrapPanel>
                </StackPanel>

                <!-- Tombol Navigasi / Aksi Item Terpilih -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <!-- Tombol Masuk ke Folder (Hanya tampil jika item adalah direktori) -->
                    <Button Content="Masuk ke Folder" Command="{Binding DrillDownCommand}" CommandParameter="{Binding SelectedNode}"
                            Style="{StaticResource PrimaryButtonStyle}" Height="36" Margin="0,0,8,0"
                            Visibility="{Binding SelectedNode.IsDirectory, Converter={StaticResource BoolToVis}}" />

                    <!-- Tombol Buka di Explorer -->
                    <Button Content="Buka di Explorer" Command="{Binding BukaDiExplorerCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" Height="36" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
