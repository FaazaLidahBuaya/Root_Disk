<UserControl x:Class="Root.App.Views.HierarchyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Root.App.ViewModels"
             xmlns:m="clr-namespace:Root.Core.Models;assembly=Root.Core"
             xmlns:conv="clr-namespace:Root.App.Converters"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:HierarchyViewModel}"
             Foreground="{DynamicResource BrushTextPrimary}">

    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:BooleanToVisibilityConverter x:Key="InvertBoolToVis" Invert="True" />
        <conv:NullToVisibilityConverter x:Key="NullToVis" />
        <conv:TreeRowWidthConverter x:Key="TreeRowWidthConverter" />
        <conv:RelativeBarWidthConverter x:Key="RelativeBarWidthConverter" />

        <!-- Template Hierarkis TreeView untuk Direktori dan Berkas -->
        <HierarchicalDataTemplate DataType="{x:Type m:FileSystemItemModel}" ItemsSource="{Binding Children}">
                    <Border Padding="4,3" CornerRadius="4" Margin="1" HorizontalAlignment="Stretch">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=TreeViewItem}, Path=IsMouseOver}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource BrushHoverSurface}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=TreeViewItem}, Path=IsSelected}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource BrushSelectedSurface}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                <Grid>
                    <Grid.Width>
                        <MultiBinding Converter="{StaticResource TreeRowWidthConverter}">
                            <Binding RelativeSource="{RelativeSource AncestorType=TreeView}" Path="ActualWidth" />
                            <Binding Path="ParentPath" />
                            <Binding RelativeSource="{RelativeSource AncestorType=TreeView}" Path="DataContext.RawRoot.FullPath" />
                            <Binding Path="FullPath" />
                        </MultiBinding>
                    </Grid.Width>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="100" />
                    </Grid.ColumnDefinitions>

                    <!-- Ikon -->
                    <TextBlock Grid.Column="0" Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource BrushAccentCyan}" Visibility="{Binding IsDirectory, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="0" Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource BrushTextMuted}" Visibility="{Binding IsDirectory, Converter={StaticResource InvertBoolToVis}}" VerticalAlignment="Center" />

                    <!-- Nama -->
                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="Medium" Foreground="{DynamicResource BrushTextPrimary}" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}" />

                    <!-- Bar ukuran relatif terhadap item terbesar pada tingkat yang sama. -->
                    <Grid Grid.Column="2" Height="28" Margin="2,0,8,0" ClipToBounds="True" VerticalAlignment="Center">
                        <Border Background="{DynamicResource BrushSizeBar}" CornerRadius="4" HorizontalAlignment="Left">
                            <Border.Width>
                                <MultiBinding Converter="{StaticResource RelativeBarWidthConverter}">
                                    <Binding RelativeSource="{RelativeSource AncestorType=Grid}" Path="ActualWidth" />
                                    <Binding Path="RelativeSize" />
                                </MultiBinding>
                            </Border.Width>
                        </Border>
                        <TextBlock Text="{Binding FormattedSize}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" Margin="8,0,2,0"
                                   HorizontalAlignment="Left">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource BrushSizeValue}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource BrushAccentCyan}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <!-- Jenis item: folder atau ekstensi berkas. -->
                    <TextBlock Grid.Column="3" Text="{Binding TypeDescription}" Foreground="{DynamicResource BrushTextMuted}" FontSize="11" VerticalAlignment="Center"
                               Margin="12,0,8,0" HorizontalAlignment="Right" />
                </Grid>
            </Border>
        </HierarchicalDataTemplate>
    </UserControl.Resources>

    <Grid Margin="0,0,10,10">
        <Grid.RowDefinitions>
            <!-- Baris 1: Bilah Kontrol & Filter -->
            <RowDefinition Height="Auto" />
            <!-- Baris 2: Tampilan Hierarkis TreeView -->
            <RowDefinition Height="*" />
            <!-- Baris 3: Panel Rincian Item Terpilih -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- BARIS 1: BILAH FILTER & PENGURUTAN -->
        <Border Grid.Row="0" Style="{StaticResource RootCardStyle}" Margin="0,0,0,12" Padding="12,10">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,-6">
                <!-- Urutkan Berdasarkan -->
                <TextBlock Text="Urutkan:" Foreground="{DynamicResource BrushTextSecondary}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,8" />
                <ComboBox SelectedValue="{Binding SelectedSortField}" SelectedValuePath="Tag" Width="130" Height="34" Style="{StaticResource RootComboBoxStyle}" Margin="0,0,8,8">
                    <ComboBoxItem Content="Ukuran" Tag="{x:Static m:SortField.Ukuran}" IsSelected="True" />
                    <ComboBoxItem Content="Nama" Tag="{x:Static m:SortField.Nama}" />
                    <ComboBoxItem Content="Tanggal Diubah" Tag="{x:Static m:SortField.TanggalDiubah}" />
                </ComboBox>

                <ComboBox SelectedValue="{Binding SelectedSortDirection}" SelectedValuePath="Tag" Width="105" Height="34" Style="{StaticResource RootComboBoxStyle}" Margin="0,0,14,8">
                    <ComboBoxItem Content="Menurun" Tag="{x:Static m:SortDirection.Menurun}" IsSelected="True" />
                    <ComboBoxItem Content="Menaik" Tag="{x:Static m:SortDirection.Menaik}" />
                </ComboBox>

                <!-- Filter Ekstensi -->
                <TextBlock Text="Ekstensi:" Foreground="{DynamicResource BrushTextSecondary}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,8" />
                <ComboBox Text="{Binding FilterExtension, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" Width="110" Height="34" Style="{StaticResource RootComboBoxStyle}" Margin="0,0,14,8">
                    <ComboBoxItem Content="Semua" IsSelected="True" />
                    <ComboBoxItem Content=".exe" />
                    <ComboBoxItem Content=".dll" />
                    <ComboBoxItem Content=".mp4" />
                    <ComboBoxItem Content=".mkv" />
                    <ComboBoxItem Content=".zip" />
                    <ComboBoxItem Content=".rar" />
                    <ComboBoxItem Content=".pdf" />
                    <ComboBoxItem Content=".docx" />
                    <ComboBoxItem Content=".iso" />
                </ComboBox>

                <!-- Batas Ukuran Minimum -->
                <TextBlock Text="Min Ukuran:" Foreground="{DynamicResource BrushTextSecondary}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,8" />
                <ComboBox ItemsSource="{Binding SizeOptions}" SelectedItem="{Binding SelectedSizeOption}" Width="130" Height="34" Style="{StaticResource RootComboBoxStyle}" Margin="0,0,14,8" />

                <!-- Cari Nama -->
                <TextBlock Text="Cari:" Foreground="{DynamicResource BrushTextSecondary}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,8" />
                <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Width="130" Height="34" Style="{StaticResource RootTextBoxStyle}" Margin="0,0,12,8" VerticalContentAlignment="Center" />

                <!-- Tombol Reset -->
                <Button Content="Reset Filter" Command="{Binding ResetFilterCommand}" Style="{StaticResource SecondaryButtonStyle}" Height="34" Padding="12,2" Margin="0,0,0,8" />
            </WrapPanel>
        </Border>

        <!-- BARIS 2: KONTEN TREEVIEW HIERARKIS -->
        <Border Grid.Row="1" Style="{StaticResource RootCardStyle}" Padding="6">
            <Grid>
                <!-- Kondisi Belum Ada Data -->
            <Border Background="{DynamicResource BrushCardBg}" CornerRadius="6" Visibility="{Binding HasData, Converter={StaticResource InvertBoolToVis}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
                        <Border Background="{DynamicResource BrushInputBg}" CornerRadius="12" Width="64" Height="64" HorizontalAlignment="Center" Margin="0,0,0,16">
                            <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="32" Foreground="{DynamicResource BrushAccentGreen}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Belum ada hasil pemindaian" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource BrushTextPrimary}" />
                    </StackPanel>
                </Border>

                <!-- TreeView Aktif -->
                <Grid Visibility="{Binding HasData, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{DynamicResource BrushDarkBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="0,0,0,1" Padding="7,0">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="Nama" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="Ukuran" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,16,0" />
                            <TextBlock Grid.Column="3" Text="Jenis" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="12,0,8,0" />
                        </Grid>
                    </Border>
                    <TreeView Grid.Row="1" ItemsSource="{Binding HierarchyItems}" Background="Transparent" BorderThickness="0"
                              SelectedItemChanged="TreeView_SelectedItemChanged"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                              ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="{x:Type TreeViewItem}">
                            <Setter Property="IsExpanded" Value="False" />
                            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Padding" Value="2" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ParentPath}" Value="{x:Null}">
                                    <Setter Property="IsExpanded" Value="True" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TreeView.ItemContainerStyle>
                    </TreeView>
                </Grid>
            </Grid>
        </Border>

        <!-- BARIS 3: PANEL RINCIAN ITEM TERPILIH -->
        <Border Grid.Row="2" Style="{StaticResource RootCardStyle}" Margin="0,12,0,0" Padding="14,12"
                Visibility="{Binding SelectedItem, Converter={StaticResource NullToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Border Background="{DynamicResource BrushAccentCyan}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                            <TextBlock Text="{Binding SelectedItem.TypeDescription}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushTextPrimary}" />
                        </Border>
                        <TextBlock Text="{Binding SelectedItem.Name}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <WrapPanel Orientation="Horizontal">
                        <TextBlock Text="Ukuran: " Foreground="{DynamicResource BrushTextMuted}" FontSize="12" />
                        <TextBlock Text="{Binding SelectedItem.FormattedSize}" FontWeight="Bold" Foreground="{DynamicResource BrushAccentGreen}" FontSize="12" Margin="0,0,16,0" />

                        <TextBlock Text="Item / Berkas: " Foreground="{DynamicResource BrushTextMuted}" FontSize="12" Visibility="{Binding SelectedItem.IsDirectory, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding SelectedItem.TotalSubItems, StringFormat='{}{0:N0} item'}" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" FontSize="12" Margin="0,0,16,0"
                                   Visibility="{Binding SelectedItem.IsDirectory, Converter={StaticResource BoolToVis}}" />

                        <TextBlock Text="Jalur: " Foreground="{DynamicResource BrushTextMuted}" FontSize="12" />
                        <TextBlock Text="{Binding SelectedItem.FullPath}" Foreground="{DynamicResource BrushTextSecondary}" FontSize="12" FontFamily="{StaticResource FontMono}" TextTrimming="CharacterEllipsis" />
                    </WrapPanel>
                </StackPanel>

                <!-- Tombol Aksi -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Button Content="Salin Jalur" Command="{Binding SalinJalurCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" Height="36" Margin="0,0,8,0" />

                    <Button Content="Buka di Explorer" Command="{Binding BukaDiExplorerCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" Height="36" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
