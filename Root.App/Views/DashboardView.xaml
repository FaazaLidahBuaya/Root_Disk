<UserControl x:Class="Root.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Root.App.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}"
             Foreground="{StaticResource BrushTextPrimary}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,10,24">

            <!-- KARTU 1: KAPASITAS DRIVE & TARGET PEMINDAIAN -->
            <Border Style="{StaticResource RootCardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <!-- Header Kartu -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Kapasitas Drive &amp; Target Analisis" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource BrushAccentGreen}" />
                            <TextBlock Text="Pilih drive fisik atau folder khusus untuk memantau kapasitas, ruang terpakai, dan ruang bebas." 
                                       FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0" />
                        </StackPanel>

                        <!-- Status Badge Dasbor -->
                        <Border Grid.Column="1" CornerRadius="4" Padding="10,5" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#F1F3FA" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsStateMemuat}" Value="True">
                                            <Setter Property="Background" Value="#EEF4FF" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsStateSelesai}" Value="True">
                                            <Setter Property="Background" Value="#E8F6EF" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsStateParsial}" Value="True">
                                            <Setter Property="Background" Value="#FFF4E5" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsStateGagal}" Value="True">
                                            <Setter Property="Background" Value="#FFF0F2" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontSize="11" FontWeight="Bold" Foreground="#202B45">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value=" Siap Dipindai" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsStateMemuat}" Value="True">
                                                    <Setter Property="Text" Value=" Memindai Aktif" />
                                                    <Setter Property="Foreground" Value="#1D4ED8" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsStateSelesai}" Value="True">
                                                    <Setter Property="Text" Value=" Selesai Penuh (100%)" />
                                                    <Setter Property="Foreground" Value="#18794E" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsStateParsial}" Value="True">
                                                    <Setter Property="Text" Value=" Selesai Sebagian (Parsial)" />
                                                    <Setter Property="Foreground" Value="#806000" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsStateGagal}" Value="True">
                                                    <Setter Property="Text" Value=" Gagal / Dibatalkan" />
                                                    <Setter Property="Foreground" Value="#B84258" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Pilihan Target: Radio Buttons & Inputs -->
                    <Border Background="#FFFFFF" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,14">
                        <StackPanel>
                            <!-- Radio Pilihan Target -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <RadioButton Content="Drive Penyimpanan Sistem" IsChecked="{Binding IsCustomPathSelected, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}" 
                                             GroupName="DashboardTargetGroup" Foreground="{StaticResource BrushTextPrimary}" FontWeight="Medium" Margin="0,0,24,0" VerticalAlignment="Center" />
                                <RadioButton Content="Folder Kustom Khusus" IsChecked="{Binding IsCustomPathSelected}" 
                                             GroupName="DashboardTargetGroup" Foreground="{StaticResource BrushTextPrimary}" FontWeight="Medium" VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- Kontrol Pilihan Drive -->
                            <Grid Visibility="{Binding IsCustomPathSelected, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ComboBox ItemsSource="{Binding Drives}" SelectedItem="{Binding SelectedDrive}" SelectionChanged="DriveSelection_Changed"
                                          Style="{StaticResource RootComboBoxStyle}" Height="38">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="4,2">
                                                <TextBlock Text="&#xE8D7;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource BrushAccentCyan}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="#202B45" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding DriveFormat, StringFormat=' ({0})'}" Foreground="#52617E" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding FormattedTotalSize, StringFormat=' - Total {0}'}" Foreground="{StaticResource BrushAccentCyan}" VerticalAlignment="Center" Margin="6,0,0,0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <Button Grid.Column="1" Content="Segarkan" Command="{Binding SegarkanDrivesCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0" Height="38" Padding="12,4" />
                            </Grid>

                            <!-- Kontrol Pilihan Folder Kustom -->
                            <Grid Visibility="{Binding IsCustomPathSelected, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBox Text="{Binding CustomPath, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{StaticResource RootTextBoxStyle}" Height="38" VerticalContentAlignment="Center" />

                                <Button Grid.Column="1" Content="Telusuri..." Command="{Binding PilihFolderCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0" Height="38" Padding="12,4" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- METRIK KAPASITAS DRIVE (3 KARTU KECIL + BAR VISUAL) -->
                    <Border Background="#F7F8FC" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="PEMANFAATAN RUANG DRIVE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" />
                                <TextBlock Grid.Column="1" Text="{Binding FormattedDriveUsedPercentage, StringFormat='Terpakai: {0}'}" 
                                           FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushAccentCyan}" />
                            </Grid>

                            <!-- Visual Storage Bar (Dual Color: Used vs Free) -->
                            <Grid Height="12" Margin="0,0,0,12">
                                <!-- Background Bar: Free Space (Green) -->
                                <Border Background="#E8F6EF" CornerRadius="6" />
                                <!-- Foreground Bar: Used Space (Cyan/Blue) -->
                                <ProgressBar x:Name="DriveCapacityBar" Value="{Binding DriveUsedPercentage, Mode=OneWay}" Maximum="100" Height="12"
                                             Style="{StaticResource RootProgressBarStyle}" Loaded="DriveCapacityBar_Loaded" />
                            </Grid>

                            <!-- 3 Kartu Kapasitas -->
                            <UniformGrid Columns="3" Rows="1" Margin="-4">
                                <Border Background="#FFFFFF" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="4">
                                    <StackPanel>
                                        <TextBlock Text="KAPASITAS TOTAL" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" />
                                        <TextBlock Text="{Binding FormattedDriveCapacity}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Background="#FFFFFF" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="4">
                                    <StackPanel>
                                        <TextBlock Text="RUANG TERPAKAI" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" />
                                        <TextBlock Text="{Binding FormattedDriveUsed}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrushAccentCyan}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Background="#FFFFFF" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="4">
                                    <StackPanel>
                                        <TextBlock Text="RUANG BEBAS" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" />
                                        <TextBlock Text="{Binding FormattedDriveFree}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrushAccentGreen}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- Tombol Aksi Pemindaian -->
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Mulai Pemindaian Dasbor" Command="{Binding MulaiPemindaianCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" Height="40" Margin="0,0,10,0" />
                        
                        <Button Content="Batalkan" Command="{Binding BatalPemindaianCommand}"
                                Style="{StaticResource DangerButtonStyle}" Height="40" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- KARTU 2: STATUS DINAMIS & KEMAJUAN (MEMUAT / KOSONG / GAGAL / PARSIAL / SELESAI) -->
            <Border Style="{StaticResource RootCardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <!-- Status Header -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Status Pemindaian: " FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" />
                            <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" />
                        </StackPanel>

                        <TextBlock Grid.Column="1" Text="{Binding ElapsedTime, StringFormat='Durasi: {0}'}" FontWeight="Bold" Foreground="{StaticResource BrushAccentAmber}" VerticalAlignment="Center" />
                    </Grid>

                    <!-- Progress Bar Saat Memuat -->
                    <ProgressBar IsIndeterminate="{Binding IsScanning}" Height="6" Margin="0,0,0,12" 
                                 Style="{StaticResource RootProgressBarStyle}" />

                    <!-- Indikator Jalur Aktif -->
                    <DockPanel LastChildFill="True" Margin="0,0,0,14" Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Sedang Memindai: " Foreground="{StaticResource BrushTextMuted}" FontWeight="SemiBold" DockPanel.Dock="Left" FontSize="11" />
                        <TextBlock Text="{Binding CurrentScannedPath}" Foreground="{StaticResource BrushAccentCyan}" 
                                   FontFamily="{StaticResource FontMono}" FontSize="11" TextTrimming="CharacterEllipsis" />
                    </DockPanel>

                    <!-- Tampilan Banner Kondisi KOSONG -->
                    <Border Background="#F7F8FC" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="20"
                            Visibility="{Binding IsStateKosong, Converter={StaticResource BoolToVis}}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text=" Belum Ada Analisis Pemindaian" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Center" />
                            <TextBlock Text="Pilih drive di atas dan klik 'Mulai Pemindaian Dasbor' untuk menganalisis pemanfaatan ruang berkas, folder, dan riwayat." 
                                       FontSize="12" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Tampilan Banner Kondisi PARSIAL -->
                    <Border Background="#FFF4E5" BorderBrush="{StaticResource BrushAccentAmber}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12"
                            Visibility="{Binding IsStateParsial, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text=" HASIL PEMINDAIAN PARSIAL (SELESAI SEBAGIAN)" FontWeight="Bold" Foreground="#8A5A00" FontSize="12" />
                            </StackPanel>
                            <TextBlock Text="Sebagian folder dilewati karena batasan izin akses sistem berkas Windows (NTFS ACL). Gunakan tombol 'Mulai Ulang Admin' di sudut kanan atas untuk mengelevasi hak akses Administrator." 
                                       FontSize="11" Foreground="#806000" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Tampilan Banner Kondisi GAGAL -->
                    <Border Background="#FFF0F2" BorderBrush="{StaticResource BrushAccentRose}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12"
                            Visibility="{Binding IsStateGagal, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text=" PEMINDAIAN DIHENTIKAN / MENGALAMI KEGAGALAN" FontWeight="Bold" Foreground="#B84258" FontSize="12" />
                            <TextBlock Text="{Binding ErrorMessage, FallbackValue='Operasi pemindaian dibatalkan sebelum selesai.'}" 
                                       FontSize="11" Foreground="#8F3345" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Tampilan Banner Kondisi SELESAI PENUH -->
                    <Border Background="#E8F6EF" BorderBrush="{StaticResource BrushAccentGreen}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12"
                            Visibility="{Binding IsStateSelesai, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text=" PEMINDAIAN LENGKAP 100% SUKSES" FontWeight="Bold" Foreground="#18794E" FontSize="12" />
                            <TextBlock Text=" - Seluruh direktori target berhasil diindeks tanpa ada item yang dilewati." FontSize="11" Foreground="#276749" Margin="4,0,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- 6 KARTU METRIK PEMINDAIAN -->
                    <UniformGrid Columns="3" Rows="2" Margin="-4">
                        <Border Background="#FFFFFF" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="4">
                            <StackPanel>
                                <TextBlock Text="TOTAL UKURAN TERPINDAI" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" />
                                <TextBlock Text="{Binding FormattedTotalSize}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrushAccentGreen}" Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Background="#FFFFFF" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="4">
                            <StackPanel>
                                <TextBlock Text="WAKTU PEMINDAIAN" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" />
                                <TextBlock Text="{Binding ElapsedTime}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Background="#FFFFFF" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="4">
                            <StackPanel>
                                <TextBlock Text="JUMLAH BERKAS" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" />
                                <TextBlock Text="{Binding ScannedFiles, StringFormat='{}{0:N0} berkas'}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrushAccentCyan}" Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Background="#FFFFFF" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="4">
                            <StackPanel>
                                <TextBlock Text="JUMLAH DIREKTORI" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" />
                                <TextBlock Text="{Binding ScannedDirectories, StringFormat='{}{0:N0} folder'}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Background="#FFFFFF" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="4">
                            <StackPanel>
                                <TextBlock Text="KECEPATAN PINDAI" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" />
                                <TextBlock Text="{Binding ScanRate}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource BrushAccentAmber}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>

                        <Border Background="#FFFFFF" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="4">
                            <StackPanel>
                                <TextBlock Text="ITEM DILEWATI / IZIN DITOLAK" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" />
                                <TextBlock Text="{Binding SkippedCount, StringFormat='{}{0:N0} item'}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrushAccentRose}" Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- KARTU 3: PERBANDINGAN HASIL PEMINDAIAN LAMA VS BARU -->
            <Border Style="{StaticResource RootCardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Perbandingan Hasil Pemindaian (Terkini vs Lama)" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource BrushAccentCyan}" />
                            <TextBlock Text="{Binding Comparison.HistoricalComparisonLabel, FallbackValue='Belum ada pemindaian sebelumnya pada target ini.'}" 
                                       FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0" />
                        </StackPanel>

                        <!-- Label Data Lama Terverifikasi -->
                        <Border Grid.Column="1" Background="#F1F3FA" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="4" Padding="8,4"
                                Visibility="{Binding HasComparison, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text=" Komparasi Data Historis" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" />
                        </Border>
                    </Grid>

                    <!-- Konten Komparasi jika Tersedia -->
                    <StackPanel Visibility="{Binding HasComparison, Converter={StaticResource BoolToVis}}">
                        <!-- Ringkasan Teks Perubahan -->
                        <Border Background="#FFFFFF" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                            <TextBlock Text="{Binding Comparison.ComparisonSummary}" FontSize="12" Foreground="{StaticResource BrushTextPrimary}" TextWrapping="Wrap" />
                        </Border>

                        <!-- 4 Kartu Delta Perubahan -->
                        <UniformGrid Columns="4" Rows="1" Margin="-4">
                            <Border Background="#FFFFFF" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="4">
                                <StackPanel>
                                    <TextBlock Text="DELTA UKURAN" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" />
                                    <TextBlock Text="{Binding Comparison.FormattedDeltaSize}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrushAccentAmber}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Background="#FFFFFF" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="4">
                                <StackPanel>
                                    <TextBlock Text="DELTA BERKAS" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" />
                                    <TextBlock Text="{Binding Comparison.FormattedDeltaFiles}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrushAccentCyan}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Background="#FFFFFF" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="4">
                                <StackPanel>
                                    <TextBlock Text="DELTA FOLDER" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" />
                                    <TextBlock Text="{Binding Comparison.FormattedDeltaDirectories}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Background="#FFFFFF" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="4">
                                <StackPanel>
                                    <TextBlock Text="TREN PENYIMPANAN" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" />
                                    <TextBlock Text="{Binding Comparison.Trend}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BrushAccentGreen}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>

                    <!-- Info jika Belum Ada Pemindaian Sebelumnya -->
                    <Border Background="#F7F8FC" CornerRadius="6" Padding="14"
                            Visibility="{Binding HasComparison, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}">
                        <TextBlock Text="ℹ️ Ini adalah pemindaian pertama untuk target ini. Catatan telah disimpan ke SQLite dan perbandingan delta akan tampil pada pemindaian berikutnya." 
                                   FontSize="11" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- KARTU 4: RIWAYAT PEMINDAIAN (SQLITE PERSISTENCE) -->
            <Border Style="{StaticResource RootCardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Riwayat Pemindaian (SQLite)" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" />
                            <TextBlock Text="Catatan historis seluruh pemindaian yang tersimpan secara persisten di database SQLite lokal." 
                                       FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0" />
                        </StackPanel>

                        <!-- Tombol Bersihkan Riwayat -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Hapus Catatan Terpilih" Command="{Binding HapusRiwayatItemCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" Height="30" Margin="0,0,8,0" Padding="10,2" FontSize="11" />
                            <Button Content="Bersihkan Semua" Command="{Binding BersihkanSemuaRiwayatCommand}"
                                    Style="{StaticResource DangerButtonStyle}" Height="30" Padding="10,2" FontSize="11" />
                        </StackPanel>
                    </Grid>

                    <!-- DataGrid Riwayat SQLite -->
                    <DataGrid ItemsSource="{Binding ScanHistory}"
                              SelectedItem="{Binding SelectedHistoryRecord}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              MaxHeight="260"
                              SelectionMode="Single"
                              Style="{StaticResource HierarchyDataGridStyle}">
                        <DataGrid.Columns>
                            <!-- ID -->
                            <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="40">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Target Name & Path -->
                            <DataGridTextColumn Header="Target Pemindaian" Binding="{Binding TargetPath}" Width="180">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Label Historis -->
                            <DataGridTextColumn Header="Tipe Data" Binding="{Binding HistoricalLabel}" Width="160">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource BrushAccentCyan}" />
                                        <Setter Property="FontSize" Value="11" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Waktu Pindai -->
                            <DataGridTextColumn Header="Waktu Pindai" Binding="{Binding FormattedScannedAt}" Width="140">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Durasi -->
                            <DataGridTextColumn Header="Durasi" Binding="{Binding FormattedDuration}" Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Ukuran Total -->
                            <DataGridTextColumn Header="Ukuran" Binding="{Binding FormattedTotalSize}" Width="90">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="Foreground" Value="{StaticResource BrushAccentGreen}" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Berkas -->
                            <DataGridTextColumn Header="Berkas" Binding="{Binding TotalFiles, StringFormat='{}{0:N0}'}" Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Status -->
                            <DataGridTextColumn Header="Status" Binding="{Binding StatusDescription}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Medium" />
                                        <Setter Property="Foreground" Value="{StaticResource BrushAccentCyan}" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Aksi Bandingkan -->
                            <DataGridTemplateColumn Header="Aksi" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Bandingkan"
                                                Command="{Binding DataContext.TerapkanRiwayatUntukKomparasiCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Height="24" Padding="6,1" FontSize="11" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- KARTU 5: JALAN PINTAS ALAT ANALISIS LANJUTAN -->
            <Border Style="{StaticResource RootCardStyle}">
                <StackPanel>
                    <TextBlock Text="Eksplorasi &amp; Alat Analisis Lanjutan ROOT" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,10" />
                    
                    <StackPanel Orientation="Horizontal">
                        <Button Command="{Binding BukaTreemapCommand}" Style="{StaticResource SecondaryButtonStyle}" Height="36" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE80A;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" Foreground="{StaticResource BrushAccentGreen}" />
                                <TextBlock Text="Buka Treemap Interaktif" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding BukaHierarkiCommand}" Style="{StaticResource SecondaryButtonStyle}" Height="36" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" Foreground="#438BE8" />
                                <TextBlock Text="Buka Pohon Hierarki" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding BukaPembersihanCommand}" Style="{StaticResource SecondaryButtonStyle}" Height="36">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" Foreground="{StaticResource BrushAccentAmber}" />
                                <TextBlock Text="Buka Pembersihan Konservatif" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
